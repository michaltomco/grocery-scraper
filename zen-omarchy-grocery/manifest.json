{
  "manifest_version": 2,
  "name": "Omarchy colors for Grocery Prices",
  "version": "0.1.0",
  "description": "Applies the current Omarchy palette only to the grocery-scraper website.",
  "permissions": ["nativeMessaging"],
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-grocery@local"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://100.72.212.47:8088/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
